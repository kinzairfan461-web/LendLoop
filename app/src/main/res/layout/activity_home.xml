<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@color/surface"
        android:elevation="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LendLoop"
            android:textColor="@color/deep_purple"
            android:textSize="26sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡"
            android:textColor="@color/deep_purple"
            android:textSize="28sp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back! "
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find what you need from your campus."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="7dp"/>
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:padding="14dp"
                android:hint="Search items..."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:singleLine="true"
                android:inputType="text"
                android:background="@drawable/item_card_bg"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Items"
                android:textColor="@color/deep_purple"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/item_card_bg">
                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="📚"
                    android:textSize="30sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Programming Book"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available for borrowing"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:background="@color/mint_green"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/item_card_bg">
                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="🎧"
                    android:textSize="30sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Headphones"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available for borrowing"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:background="@color/mint_green"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/item_card_bg">
                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="💻"
                    android:textSize="30sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Laptop Charger"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available for borrowing"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:background="@color/mint_green"/>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/btnAddItem"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="22dp"
                android:text="+ Add Your Item"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/deep_purple"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="5dp">
        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂&#10;Home"
            android:textColor="@color/deep_purple"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface"/>
        <Button
            android:id="@+id/btnMyItems"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="▣&#10;My Items"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface"/>
        <Button
            android:id="@+id/btnRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♡&#10;Requests"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface"/>
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♙&#10;Profile"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface"/>
    </LinearLayout>
</LinearLayout>
